// Fixed independent binary64/Decimal expected outputs; see deep-repair-05 DECIMAL-ORACLE.json.

///|
test "deep05 exact decimal scaling half-neighbors" {
  assert_eq(
    format_su(4.9999999999999996e-05, 0.0001, digits=1),
    Ok("0.0000(1)"),
  )
  assert_eq(
    format_su(-4.9999999999999996e-05, 0.0001, digits=1),
    Ok("0.0000(1)"),
  )
  assert_eq(format_su(5.0e-05, 0.0001, digits=1), Ok("0.0001(1)"))
  assert_eq(format_su(-5.0e-05, 0.0001, digits=1), Ok("-0.0001(1)"))
  assert_eq(format_su(5.000000000000001e-05, 0.0001, digits=1), Ok("0.0001(1)"))
  assert_eq(
    format_su(-5.000000000000001e-05, 0.0001, digits=1),
    Ok("-0.0001(1)"),
  )
  assert_eq(
    format_su(0.00014999999999999996, 0.0001, digits=1),
    Ok("0.0001(1)"),
  )
  assert_eq(
    format_su(-0.00014999999999999996, 0.0001, digits=1),
    Ok("-0.0001(1)"),
  )
  assert_eq(format_su(0.00015, 0.0001, digits=1), Ok("0.0001(1)"))
  assert_eq(format_su(-0.00015, 0.0001, digits=1), Ok("-0.0001(1)"))
  assert_eq(
    format_su(0.00015000000000000001, 0.0001, digits=1),
    Ok("0.0002(1)"),
  )
  assert_eq(
    format_su(-0.00015000000000000001, 0.0001, digits=1),
    Ok("-0.0002(1)"),
  )
  assert_eq(format_su(0.0012499999999999998, 0.0001, digits=1), Ok("0.0012(1)"))
  assert_eq(
    format_su(-0.0012499999999999998, 0.0001, digits=1),
    Ok("-0.0012(1)"),
  )
  assert_eq(format_su(0.00125, 0.0001, digits=1), Ok("0.0013(1)"))
  assert_eq(format_su(-0.00125, 0.0001, digits=1), Ok("-0.0013(1)"))
  assert_eq(format_su(0.0012500000000000002, 0.0001, digits=1), Ok("0.0013(1)"))
  assert_eq(
    format_su(-0.0012500000000000002, 0.0001, digits=1),
    Ok("-0.0013(1)"),
  )
  assert_eq(format_su(0.009949999999999999, 0.0001, digits=1), Ok("0.0099(1)"))
  assert_eq(
    format_su(-0.009949999999999999, 0.0001, digits=1),
    Ok("-0.0099(1)"),
  )
  assert_eq(format_su(0.00995, 0.0001, digits=1), Ok("0.0100(1)"))
  assert_eq(format_su(-0.00995, 0.0001, digits=1), Ok("-0.0100(1)"))
  assert_eq(format_su(0.009950000000000002, 0.0001, digits=1), Ok("0.0100(1)"))
  assert_eq(
    format_su(-0.009950000000000002, 0.0001, digits=1),
    Ok("-0.0100(1)"),
  )
  assert_eq(format_su(7.0, 0.00014999999999999996, digits=1), Ok("7.0000(1)"))
  assert_eq(format_su(7.0, 0.00015, digits=1), Ok("7.0000(1)"))
  assert_eq(format_su(7.0, 0.00015000000000000001, digits=1), Ok("7.0000(2)"))
  assert_eq(format_su(7.0, 0.0009499999999999999, digits=1), Ok("7.0000(9)"))
  assert_eq(format_su(7.0, 0.00095, digits=1), Ok("7.0000(9)"))
  assert_eq(format_su(7.0, 0.0009500000000000001, digits=1), Ok("7.000(1)"))
  assert_eq(format_su(7.0, 0.0009949999999999998, digits=1), Ok("7.000(1)"))
  assert_eq(format_su(7.0, 0.000995, digits=1), Ok("7.000(1)"))
  assert_eq(format_su(7.0, 0.0009950000000000002, digits=1), Ok("7.000(1)"))
  assert_eq(format_su(7.0, 0.00014999999999999996, digits=2), Ok("7.00000(15)"))
  assert_eq(format_su(7.0, 0.00015, digits=2), Ok("7.00000(15)"))
  assert_eq(format_su(7.0, 0.00015000000000000001, digits=2), Ok("7.00000(15)"))
  assert_eq(format_su(7.0, 0.0009499999999999999, digits=2), Ok("7.00000(95)"))
  assert_eq(format_su(7.0, 0.00095, digits=2), Ok("7.00000(95)"))
  assert_eq(format_su(7.0, 0.0009500000000000001, digits=2), Ok("7.00000(95)"))
  assert_eq(format_su(7.0, 0.0009949999999999998, digits=2), Ok("7.00000(99)"))
  assert_eq(format_su(7.0, 0.000995, digits=2), Ok("7.0000(10)"))
  assert_eq(format_su(7.0, 0.0009950000000000002, digits=2), Ok("7.0000(10)"))
  assert_eq(format_su(0.049999999999999996, 0.1, digits=1), Ok("0.0(1)"))
  assert_eq(format_su(-0.049999999999999996, 0.1, digits=1), Ok("0.0(1)"))
  assert_eq(format_su(0.05, 0.1, digits=1), Ok("0.1(1)"))
  assert_eq(format_su(-0.05, 0.1, digits=1), Ok("-0.1(1)"))
  assert_eq(format_su(0.05000000000000001, 0.1, digits=1), Ok("0.1(1)"))
  assert_eq(format_su(-0.05000000000000001, 0.1, digits=1), Ok("-0.1(1)"))
  assert_eq(format_su(0.14999999999999997, 0.1, digits=1), Ok("0.1(1)"))
  assert_eq(format_su(-0.14999999999999997, 0.1, digits=1), Ok("-0.1(1)"))
  assert_eq(format_su(0.15, 0.1, digits=1), Ok("0.1(1)"))
  assert_eq(format_su(-0.15, 0.1, digits=1), Ok("-0.1(1)"))
  assert_eq(format_su(0.15000000000000002, 0.1, digits=1), Ok("0.2(1)"))
  assert_eq(format_su(-0.15000000000000002, 0.1, digits=1), Ok("-0.2(1)"))
  assert_eq(format_su(1.2499999999999998, 0.1, digits=1), Ok("1.2(1)"))
  assert_eq(format_su(-1.2499999999999998, 0.1, digits=1), Ok("-1.2(1)"))
  assert_eq(format_su(1.25, 0.1, digits=1), Ok("1.3(1)"))
  assert_eq(format_su(-1.25, 0.1, digits=1), Ok("-1.3(1)"))
  assert_eq(format_su(1.2500000000000002, 0.1, digits=1), Ok("1.3(1)"))
  assert_eq(format_su(-1.2500000000000002, 0.1, digits=1), Ok("-1.3(1)"))
  assert_eq(format_su(9.949999999999998, 0.1, digits=1), Ok("9.9(1)"))
  assert_eq(format_su(-9.949999999999998, 0.1, digits=1), Ok("-9.9(1)"))
  assert_eq(format_su(9.95, 0.1, digits=1), Ok("9.9(1)"))
  assert_eq(format_su(-9.95, 0.1, digits=1), Ok("-9.9(1)"))
  assert_eq(format_su(9.950000000000001, 0.1, digits=1), Ok("10.0(1)"))
  assert_eq(format_su(-9.950000000000001, 0.1, digits=1), Ok("-10.0(1)"))
  assert_eq(format_su(7.0, 0.14999999999999997, digits=1), Ok("7.0(1)"))
  assert_eq(format_su(7.0, 0.15, digits=1), Ok("7.0(1)"))
  assert_eq(format_su(7.0, 0.15000000000000002, digits=1), Ok("7.0(2)"))
  assert_eq(format_su(7.0, 0.9499999999999998, digits=1), Ok("7.0(9)"))
  assert_eq(format_su(7.0, 0.95, digits=1), Ok("7.0(9)"))
  assert_eq(format_su(7.0, 0.9500000000000001, digits=1), Ok("7(1)"))
  assert_eq(format_su(7.0, 0.9949999999999999, digits=1), Ok("7(1)"))
  assert_eq(format_su(7.0, 0.995, digits=1), Ok("7(1)"))
  assert_eq(format_su(7.0, 0.9950000000000001, digits=1), Ok("7(1)"))
  assert_eq(format_su(7.0, 0.14999999999999997, digits=2), Ok("7.00(15)"))
  assert_eq(format_su(7.0, 0.15, digits=2), Ok("7.00(15)"))
  assert_eq(format_su(7.0, 0.15000000000000002, digits=2), Ok("7.00(15)"))
  assert_eq(format_su(7.0, 0.9499999999999998, digits=2), Ok("7.00(95)"))
  assert_eq(format_su(7.0, 0.95, digits=2), Ok("7.00(95)"))
  assert_eq(format_su(7.0, 0.9500000000000001, digits=2), Ok("7.00(95)"))
  assert_eq(format_su(7.0, 0.9949999999999999, digits=2), Ok("7.00(99)"))
  assert_eq(format_su(7.0, 0.995, digits=2), Ok("7.00(99)"))
  assert_eq(format_su(7.0, 0.9950000000000001, digits=2), Ok("7.0(10)"))
  assert_eq(format_su(0.49999999999999994, 1.0, digits=1), Ok("0(1)"))
  assert_eq(format_su(-0.49999999999999994, 1.0, digits=1), Ok("0(1)"))
  assert_eq(format_su(0.5, 1.0, digits=1), Ok("1(1)"))
  assert_eq(format_su(-0.5, 1.0, digits=1), Ok("-1(1)"))
  assert_eq(format_su(0.5000000000000001, 1.0, digits=1), Ok("1(1)"))
  assert_eq(format_su(-0.5000000000000001, 1.0, digits=1), Ok("-1(1)"))
  assert_eq(format_su(1.4999999999999998, 1.0, digits=1), Ok("1(1)"))
  assert_eq(format_su(-1.4999999999999998, 1.0, digits=1), Ok("-1(1)"))
  assert_eq(format_su(1.5, 1.0, digits=1), Ok("2(1)"))
  assert_eq(format_su(-1.5, 1.0, digits=1), Ok("-2(1)"))
  assert_eq(format_su(1.5000000000000002, 1.0, digits=1), Ok("2(1)"))
  assert_eq(format_su(-1.5000000000000002, 1.0, digits=1), Ok("-2(1)"))
  assert_eq(format_su(12.499999999999998, 1.0, digits=1), Ok("12(1)"))
  assert_eq(format_su(-12.499999999999998, 1.0, digits=1), Ok("-12(1)"))
