  assert_eq(format_su(-99.49999999999999, 1.0, digits=1), Ok("-99(1)"))
  assert_eq(format_su(99.5, 1.0, digits=1), Ok("100(1)"))
  assert_eq(format_su(-99.5, 1.0, digits=1), Ok("-100(1)"))
  assert_eq(format_su(99.50000000000001, 1.0, digits=1), Ok("100(1)"))
  assert_eq(format_su(-99.50000000000001, 1.0, digits=1), Ok("-100(1)"))
  assert_eq(format_su(7.0, 1.4999999999999998, digits=1), Ok("7(1)"))
  assert_eq(format_su(7.0, 1.5, digits=1), Ok("7(2)"))
  assert_eq(format_su(7.0, 1.5000000000000002, digits=1), Ok("7(2)"))
  assert_eq(format_su(7.0, 9.499999999999998, digits=1), Ok("7(9)"))
  assert_eq(format_su(7.0, 9.5, digits=1), Ok("1e1(1)"))
  assert_eq(format_su(7.0, 9.500000000000002, digits=1), Ok("1e1(1)"))
  assert_eq(format_su(7.0, 9.949999999999998, digits=1), Ok("1e1(1)"))
  assert_eq(format_su(7.0, 9.95, digits=1), Ok("1e1(1)"))
  assert_eq(format_su(7.0, 9.950000000000001, digits=1), Ok("1e1(1)"))
  assert_eq(format_su(7.0, 1.4999999999999998, digits=2), Ok("7.0(15)"))
  assert_eq(format_su(7.0, 1.5, digits=2), Ok("7.0(15)"))
  assert_eq(format_su(7.0, 1.5000000000000002, digits=2), Ok("7.0(15)"))
  assert_eq(format_su(7.0, 9.499999999999998, digits=2), Ok("7.0(95)"))
  assert_eq(format_su(7.0, 9.5, digits=2), Ok("7.0(95)"))
  assert_eq(format_su(7.0, 9.500000000000002, digits=2), Ok("7.0(95)"))
  assert_eq(format_su(7.0, 9.949999999999998, digits=2), Ok("7.0(99)"))
  assert_eq(format_su(7.0, 9.95, digits=2), Ok("7.0(99)"))
  assert_eq(format_su(7.0, 9.950000000000001, digits=2), Ok("7(10)"))
